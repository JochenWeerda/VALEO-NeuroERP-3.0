  "users": [],
  "scopeMappings": [
    {
      "clientScope": "sales:read",
      "roles": [
        "user",
        "admin",
        "sales_manager",
        "readonly"
      ]
    },
    {
      "clientScope": "sales:write",
      "roles": [
        "user",
        "admin",
        "sales_manager"
      ]
    },
    {
      "clientScope": "sales:approve",
      "roles": [
        "admin",
        "sales_manager"
      ]
    },
    {
      "clientScope": "sales:post",
      "roles": [
        "admin"
      ]
    },
    {
      "clientScope": "policy:read",
      "roles": [
