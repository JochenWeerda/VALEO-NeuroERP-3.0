{
  "name": "@valero-neuroerp/frontend-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "routes:generate": "node scripts/generate-tanstack-routes.mjs",
    "predev": "npm run routes:generate",
    "dev": "vite",
    "dev:lan": "vite --mode lan-preview",
    "dev:docker": "vite --mode docker",
    "dev:prod": "vite --mode production",
    "prebuild": "npm run routes:generate",
    "build": "vite build",
    "build:lan": "vite build --mode lan-preview",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0 --mode lan-preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "pretype-check": "npm run routes:generate",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "type-check:focused": "tsc --noEmit --project tsconfig.typecheck.json",
    "spec-kit:generate": "spec-kit generate",
    "spec-kit:validate": "spec-kit validate",
    "spec-kit:docs": "spec-kit docs --output ./docs/specs/",
    "specs:generate": "pnpm spec-kit:generate",
    "specs:validate": "pnpm spec-kit:validate",
    "specs:docs": "pnpm spec-kit:docs",
    "storybook": "storybook dev -p 6006",
    "storybook:smoke": "storybook dev -p 6006 --ci --smoke-test",
    "build-storybook": "storybook build",
    "typecheck": "pnpm run type-check",
    "check:routing-integrity": "node scripts/check-routing-integrity.mjs",
    "check:navigation-targets": "npm run routes:generate && node scripts/check-navigation-targets.mjs",
    "test:e2e": "playwright test",
    "test:e2e:accessibility": "playwright test tests/e2e/accessibility.spec.ts --grep @accessibility",
    "test:e2e:routing-smoke": "playwright test tests/e2e/main-routes-smoke.spec.ts",
    "test:e2e:rations-compound": "playwright test tests/e2e/rations-compound-upload.spec.ts",
    "test:e2e:service-to-customer": "playwright test tests/e2e/service-to-customer-smoke.e2e.ts",
    "test:e2e:smoke-all": "node scripts/harvest-routes.mjs && playwright test tests/e2e/all-routes-smoke.spec.ts --workers=1 && node scripts/smoke-report-html.mjs",
    "test:e2e:smoke-report": "node scripts/smoke-report-html.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "screenshots:readme": "npx tsx scripts/capture-readme-screenshots.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.45.0",
    "@tanstack/react-router": "1.170.15",
    "axios": "^1.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.23.22",
    "i18next": "^25.5.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.6",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.439.0",
    "maplibre-gl": "^5.24.0",
    "oidc-client-ts": "^3.3.0",
    "openai": "^6.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.11.2",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.64.0",
    "react-i18next": "^16.0.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "uuid": "^13.0.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-docs": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/addon-onboarding": "^8.6.18",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^3.2.6",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "eslint-plugin-storybook": "^0.12.0",
    "jsdom": "^24.1.1",
    "postcss": "^8.5.15",
    "prettier": "^3.3.3",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.6",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.4",
    "vite": "^6.4.2",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.2.6"
  }
}
