# ======================================================
# VALEO NeuroERP – Alle Umgebungsvariablen (Referenz)
# ======================================================
# Szenario-spezifische Vorlagen:
#   .env                     → Lokal (npm run dev, Standard)
#   .env.docker              → Docker Compose (alle Services in Docker)
#   .env.lan-preview         → LAN-Tests (Handy/andere Geräte)
#   .env.production.example  → Produktion / Cloud / Tunnel
# ======================================================

# --- API ---
# Direct-URL (Modus A): Browser ruft Backend direkt auf, CORS erforderlich
VITE_API_BASE_URL=http://localhost:8000
# Leer lassen für Proxy-Modus (Modus B, z.B. Docker Compose)
# VITE_API_BASE_URL=

# --- Proxy-Targets (nur aktiv wenn VITE_API_BASE_URL leer) ---
VITE_BACKEND_PROXY=http://127.0.0.1:8000
VITE_BFF_PROXY=http://127.0.0.1:4001
# Optional: nur wenn ein eigener SSE-Dienst läuft. Sonst nutzt Vite dasselbe Ziel wie VITE_BACKEND_PROXY (FastAPI `/api/events`).
# VITE_SSE_PROXY=http://127.0.0.1:5174

# --- Tenant ---
VITE_TENANT_ID=YOUR-TENANT-ID

# --- OIDC ---
VITE_OIDC_DISCOVERY_URL=https://your-oidc-provider.com/.well-known/openid-configuration
VITE_OIDC_CLIENT_ID=valeo-erp-frontend
VITE_OIDC_REDIRECT_URI=http://localhost:3000/callback

# --- Entwicklung ---
VITE_API_DEV_TOKEN=dev-token
VITE_DEMO_MODE=false

# --- Feature Flags ---
VITE_ENABLE_DMS_INTEGRATION=true
VITE_ENABLE_WORKFLOW=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_PROSPECTING_UI=false
VITE_ENABLE_MSW=0
VITE_FEATURE_CONTRACT_FIXING=0
VITE_FEATURE_ADVANCED_ANALYTICS=0

# --- Dokumentation / In-App-Hilfe ---
# Basis-URL der MkDocs-Doku-Site (Hilfe-Button + User-Menü "Dokumentation").
# Default: veröffentlichte GitHub-Pages-Site (vgl. mkdocs.yml#site_url).
VITE_DOCS_URL=https://jochenweerda.github.io/VALEO-NeuroERP-3.0/

# --- Branding ---
VITE_COMPANY_NAME=VALEO NeuroERP
VITE_COMPANY_LOGO=/logo.png

# --- Analytics & Monitoring ---
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
