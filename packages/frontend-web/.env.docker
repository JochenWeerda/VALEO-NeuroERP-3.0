# ======================================================
# VALEO NeuroERP – Docker Compose Konfiguration
# ======================================================
# Für: docker compose up -d (alle Services in Docker)
#
# Verwendung:
#   cp .env.docker .env
#   docker compose up -d
#
# Modus B (Proxy): VITE_API_BASE_URL ist leer →
#   Browser ruft relativ /api/v1/... auf →
#   Vite-Dev-Server leitet an VITE_BACKEND_PROXY weiter
# ======================================================

# Leer lassen → Proxy-Modus aktiv
VITE_API_BASE_URL=

# Proxy-Targets (Docker-interne Service-Namen)
VITE_BACKEND_PROXY=http://backend:8000
VITE_BFF_PROXY=http://bff-web:4001
VITE_SSE_PROXY=http://dev-sse:5174

# Entwicklung
VITE_API_DEV_TOKEN=dev-token
VITE_DEMO_MODE=false

# Feature Flags
VITE_ENABLE_DMS_INTEGRATION=true
VITE_ENABLE_WORKFLOW=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_PROSPECTING_UI=true
