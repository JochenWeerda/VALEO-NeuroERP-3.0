# ======================================================
# VALEO NeuroERP – Tunnel-Konfiguration (ngrok / Cloudflare)
# ======================================================
# Verwendung: npm run dev (nach .env überschreiben oder als --mode tunnel)
#
# Szenarien:
#   A) ngrok:        ngrok http 8000  → VITE_API_BASE_URL=https://xxxx.ngrok.io
#   B) Cloudflare:   cloudflared tunnel → VITE_API_BASE_URL=https://xxxx.trycloudflare.com
#   C) Frp / Bore:   Eigener Reverse-Proxy
#
# Ablauf:
#   1. Backend starten: uvicorn main:app --reload --port 8000
#   2. Tunnel öffnen:   ngrok http 8000
#   3. URL kopieren:    z.B. https://abcd1234.ngrok.io
#   4. In .env setzen:  VITE_API_BASE_URL=https://abcd1234.ngrok.io
#   5. Frontend:        npm run dev (Browser ruft direkt Tunnel-URL auf)
#
# TIPP: Frontend auch tunneln für externe Zugriffe:
#   ngrok http 3001   → Zweiter Tunnel für Frontend
#   Dann VITE_HMR_HOST=yyyy.ngrok.io setzen für Hot-Reload
# ======================================================

# Backend-Tunnel-URL (HTTPS!)
VITE_API_BASE_URL=https://DEIN-TUNNEL.ngrok.io

# HMR über Tunnel (falls Frontend auch extern erreichbar sein soll)
# VITE_HMR_HOST=DEIN-FRONTEND-TUNNEL.ngrok.io

# Tenant
VITE_TENANT_ID=00000000-0000-0000-0000-000000000001

# Auth
VITE_API_DEV_TOKEN=dev-token
VITE_DEMO_MODE=false

# Feature Flags
VITE_ENABLE_DMS_INTEGRATION=true
VITE_ENABLE_WORKFLOW=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_PROSPECTING_UI=true
