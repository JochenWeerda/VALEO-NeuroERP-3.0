{
  "sales/angebote-liste": {
    "schemaVersion": 1,
    "id": "sales/angebote-liste",
    "domain": "sales",
    "mode": "list",
    "title": "Verkaufsangebote",
    "subtitle": "Angebote mit Kunde, Betrag und Gültigkeit",
    "adapter": {
      "type": "native",
      "sourceId": "sales/angebote-liste",
      "temporary": false
    },
    "dataSources": [
      {
        "key": "list",
        "endpoint": "/api/v1/sales/offers/",
        "pageSize": 100
      }
    ],
    "actions": [
      {
        "key": "neu",
        "label": "Neues Angebot",
        "kind": "primary",
        "dangerLevel": "safe",
        "zone": "header",
        "navigationRoute": "/sales/angebot/neu",
        "localEffect": "navigation",
        "stubReason": "Oeffnet die Anlage; Rechte prueft deren Anlageweg."
      },
      {
        "key": "export",
        "label": "CSV-Export",
        "kind": "secondary",
        "dangerLevel": "safe",
        "zone": "header",
        "command": "list.exportCsv",
        "localEffect": "download",
        "stubReason": "Exportiert die Liste mit ihren Spalten; keine Serverwirkung."
      },
      {
        "key": "print",
        "label": "Drucken",
        "dangerLevel": "safe",
        "zone": "header",
        "localEffect": "print"
      },
      {
        "key": "import_csv",
        "label": "CSV importieren",
        "permission": "sales.offer.import_csv",
        "dangerLevel": "moderate",
        "zone": "header",
        "commandEndpoint": "/api/v1/sales/offers/actions/import-csv",
        "method": "POST",
        "requiresConfirmation": true,
        "requiresIdempotencyKey": true,
        "forbiddenForAgents": true,
        "inputFields": [
          {
            "key": "csv_content",
            "label": "CSV-Datei",
            "type": "file",
            "required": true,
            "helpText": "UTF-8, Semikolon; Pflichtkopf: offer_number;subject;customer_id;total_amount;currency. Optional: valid_until (ISO-Datum). Alle Zeilen werden gemeinsam importiert.",
            "fileContent": {
              "encoding": "utf-8",
              "accept": ".csv",
              "maxBytes": 1048576
            }
          }
        ]
      }
    ],
    "tables": [
      {
        "key": "list",
        "label": "Verkaufsangebote",
        "dataSourceKey": "list",
        "serverPagination": false,
        "pageSize": 50,
        "virtualized": true,
        "rowHeight": 40,
        "columns": [
          {
            "key": "offer_number",
            "label": "Angebot-Nr.",
            "sortable": true,
            "filterable": true,
            "priority": "primary"
          },
          {
            "key": "created_at",
            "label": "Datum",
            "renderKind": "date",
            "sortable": true,
            "filterable": true,
            "priority": "secondary"
          },
          {
            "key": "customer_name",
            "label": "Kunde",
            "filterable": true,
            "priority": "primary"
          },
          {
            "key": "subject",
            "label": "Betreff",
            "filterable": true,
            "priority": "secondary"
          },
          {
            "key": "total_amount",
            "label": "Betrag",
            "numeric": true,
            "renderKind": "currency",
            "currencyField": "currency",
            "sortable": true,
            "priority": "primary"
          },
          {
            "key": "currency",
            "label": "Währung",
            "priority": "secondary"
          },
          {
            "key": "valid_until",
            "label": "Gültig bis",
            "renderKind": "date",
            "sortable": true,
            "priority": "secondary"
          },
          {
            "key": "status",
            "label": "Status",
            "renderKind": "status",
            "filterable": true,
            "priority": "primary"
          }
        ],
        "rowActions": [],
        "rowRouteTemplate": "/sales/angebot/{id}"
      }
    ],
    "noWorkflowReason": "Der Status steht am Angebot; die Liste führt keinen eigenen Ablauf.",
    "agentContract": {
      "businessPurpose": "Verkaufsangebote nach Kunde und Status verfolgen.",
      "examplePrompts": [
        "Welche Angebote laufen diese Woche ab?",
        "Welche Angebote sind offen?"
      ],
      "sensitiveFields": [],
      "testSelectors": {
        "screenRoot": "[data-testid='screen-sales/angebote-liste']"
      }
    },
    "layout": {
      "floorplan": "worklist",
      "density": "compact",
      "contextRail": "none",
      "preferredMode": "desktopDense",
      "mobileMode": "mobileStack",
      "touchTargetPx": 44,
      "tableProfile": "standard"
    },
    "performance": {
      "initialPayloadBudgetKb": 60,
      "requiresLazyTabs": false,
      "requiresVirtualTables": true,
      "lookupMinChars": 2,
      "bundleGroup": "sales"
    },
    "listExperience": {
      "searchFields": [
        "offer_number",
        "customer_name"
      ],
      "presets": [
        {
          "key": "status",
          "label": "Status",
          "field": "status",
          "kind": "choice",
          "options": [
            {
              "value": "all",
              "label": "Alle Status"
            },
            {
              "value": "offen",
              "label": "Offen"
            },
            {
              "value": "angenommen",
              "label": "Angenommen"
            },
            {
              "value": "abgelehnt",
              "label": "Abgelehnt"
            },
            {
              "value": "abgelaufen",
              "label": "Abgelaufen"
            }
          ]
        }
      ],
      "aggregates": [
        {
          "key": "total",
          "label": "Angebote",
          "conditions": []
        },
        {
          "key": "open",
          "label": "Offen",
          "conditions": [
            {
              "field": "status",
              "op": "eq",
              "value": "offen"
            }
          ]
        }
      ],
      "export": {
        "filenamePrefix": "Angebote_",
        "delimiter": ";",
        "columns": [
          {
            "key": "offer_number",
            "label": "Angebot-Nr."
          },
          {
            "key": "created_at",
            "label": "Datum"
          },
          {
            "key": "customer_name",
            "label": "Kunde"
          },
          {
            "key": "subject",
            "label": "Betreff"
          },
          {
            "key": "total_amount",
            "label": "Betrag"
          },
          {
            "key": "currency",
            "label": "Währung"
          },
          {
            "key": "valid_until",
            "label": "Gültig bis"
          },
          {
            "key": "status",
            "label": "Status"
          }
        ]
      },
      "insightLines": [
        {
          "key": "sales",
          "label": "Vertrieb",
          "variants": [
            {
              "text": "{open} offene Angebote in der aktuellen Sicht."
            }
          ]
        },
        {
          "key": "management",
          "label": "Leitung",
          "variants": [
            {
              "text": "{total} Angebote in der aktuellen Sicht."
            }
          ]
        }
      ],
      "roleFocus": {
        "defaultKey": "all",
        "options": [
          {
            "key": "all",
            "label": "Alle Rollen"
          },
          {
            "key": "sales",
            "label": "Vertrieb",
            "insightLineKeys": [
              "sales"
            ]
          },
          {
            "key": "inside-sales",
            "label": "Innendienst",
            "insightLineKeys": [
              "sales"
            ]
          },
          {
            "key": "order-desk",
            "label": "Auftragsabwicklung",
            "insightLineKeys": [
              "sales"
            ]
          },
          {
            "key": "finance",
            "label": "Finance",
            "insightLineKeys": [
              "management"
            ]
          },
          {
            "key": "management",
            "label": "Leitung",
            "insightLineKeys": [
              "management"
            ]
          }
        ]
      }
    }
  },
  "sales/lieferungen-liste": {
    "schemaVersion": 1,
    "id": "sales/lieferungen-liste",
    "domain": "sales",
    "mode": "list",
    "title": "Lieferscheine",
    "subtitle": "Ausgehende Lieferungen und Belegstatus",
    "adapter": {
      "type": "native",
      "sourceId": "sales/lieferungen-liste",
      "temporary": false
    },
    "dataSources": [
      {
        "key": "list",
        "endpoint": "/api/v1/sales/delivery-notes?limit=100",
        "pageSize": 100
      }
    ],
    "actions": [
      {
        "key": "neu",
        "label": "Lieferschein erfassen",
        "kind": "primary",
        "dangerLevel": "safe",
        "zone": "header",
        "navigationRoute": "/sales/delivery-editor",
        "localEffect": "navigation",
        "stubReason": "Oeffnet die Anlage; Rechte prueft deren Anlageweg."
      },
      {
        "key": "export",
        "label": "CSV-Export",
        "kind": "secondary",
        "dangerLevel": "safe",
        "zone": "header",
        "command": "list.exportCsv",
        "localEffect": "download",
        "stubReason": "Exportiert die Liste mit ihren Spalten; keine Serverwirkung."
      },
      {
        "key": "print",
        "label": "Drucken",
        "dangerLevel": "safe",
        "zone": "header",
        "localEffect": "print"
      }
    ],
    "tables": [
      {
        "key": "list",
        "label": "Lieferscheine",
        "dataSourceKey": "list",
        "serverPagination": false,
        "pageSize": 50,
        "virtualized": true,
        "rowHeight": 40,
        "columns": [
          {
            "key": "delivery_note_number",
            "label": "Lieferschein-Nr.",
            "sortable": true,
            "filterable": true,
            "priority": "primary"
          },
          {
            "key": "delivery_date",
            "label": "Datum",
            "renderKind": "date",
            "sortable": true,
            "priority": "secondary"
          },
          {
            "key": "customer_name",
            "label": "Kunde",
            "filterable": true,
            "priority": "primary"
          },
          {
            "key": "customer_id",
            "label": "Kundenreferenz",
            "filterable": true,
            "priority": "secondary"
          },
          {
            "key": "sales_order_number",
            "label": "Auftrag",
            "filterable": true,
            "priority": "primary"
          },
          {
            "key": "sales_order_id",
            "label": "Auftragsreferenz",
            "filterable": true,
            "priority": "secondary"
          },
          {
            "key": "quantity_summary",
            "label": "Mengen nach Einheit",
            "priority": "secondary"
          },
          {
            "key": "status",
            "label": "Belegstatus",
            "renderKind": "status",
            "filterable": true,
            "priority": "primary"
          },
          {
            "key": "is_delivered",
            "label": "Zugestellt",
            "renderKind": "boolean",
            "filterable": true,
            "priority": "secondary"
          }
        ],
        "rowActions": [
          {
            "key": "auftrag_oeffnen",
            "label": "Auftrag öffnen",
            "dangerLevel": "low",
            "navigationRoute": "/sales/order-editor?id={sales_order_id}",
            "localEffect": "navigation",
            "visibleWhen": {
              "field": "has_sales_order",
              "values": [
                true
              ]
            }
          }
        ],
        "rowRouteTemplate": "/sales/delivery-editor?id={id}"
      }
    ],
    "noWorkflowReason": "Der Belegstatus ist kein Transportstatus.",
    "agentContract": {
      "businessPurpose": "Lieferscheine und ihren dokumentierten Status nachverfolgen.",
      "examplePrompts": [
        "Welche Lieferscheine sind offen?",
        "Welche Lieferungen sind zugestellt?"
      ],
      "sensitiveFields": [],
      "testSelectors": {
        "screenRoot": "[data-testid='screen-sales/lieferungen-liste']"
      }
    },
    "layout": {
      "floorplan": "worklist",
      "density": "compact",
      "contextRail": "none",
      "preferredMode": "desktopDense",
      "mobileMode": "mobileStack",
      "touchTargetPx": 44,
      "tableProfile": "standard"
    },
    "performance": {
      "initialPayloadBudgetKb": 60,
      "requiresLazyTabs": false,
      "requiresVirtualTables": true,
      "lookupMinChars": 2,
      "bundleGroup": "sales"
    },
    "listExperience": {
      "searchFields": [
        "delivery_note_number",
        "customer_name",
        "customer_id",
        "sales_order_number",
        "sales_order_id"
      ],
      "presets": [
        {
          "key": "status",
          "label": "Belegstatus",
          "field": "status",
          "kind": "choice",
          "options": [
            {
              "value": "all",
              "label": "Alle Status"
            },
            {
              "value": "draft",
              "label": "Entwurf"
            },
            {
              "value": "posted",
              "label": "Gebucht"
            },
            {
              "value": "printed",
              "label": "Gedruckt"
            },
            {
              "value": "delivered",
              "label": "Zugestellt"
            },
            {
              "value": "cancelled",
              "label": "Storniert"
            }
          ]
        }
      ],
      "aggregates": [
        {
          "key": "total",
          "label": "Lieferscheine",
          "conditions": []
        },
        {
          "key": "draft",
          "label": "Entwürfe",
          "conditions": [
            {
              "field": "status",
              "op": "eq",
              "value": "draft"
            }
          ]
        },
        {
          "key": "delivered",
          "label": "Zugestellt",
          "conditions": [
            {
              "field": "is_delivered",
              "op": "eq",
              "value": "true"
            }
          ]
        }
      ],
      "export": {
        "filenamePrefix": "Lieferungen_",
        "delimiter": ";",
        "columns": [
          {
            "key": "delivery_note_number",
            "label": "Lieferschein-Nr."
          },
          {
            "key": "delivery_date",
            "label": "Datum"
          },
          {
            "key": "customer_name",
            "label": "Kunde"
          },
          {
            "key": "customer_id",
            "label": "Kundenreferenz"
          },
          {
            "key": "sales_order_number",
            "label": "Auftrag"
          },
          {
            "key": "sales_order_id",
            "label": "Auftragsreferenz"
          },
          {
            "key": "quantity_summary",
            "label": "Mengen nach Einheit"
          },
          {
            "key": "status",
            "label": "Belegstatus"
          },
          {
            "key": "is_delivered",
            "label": "Zugestellt"
          }
        ]
      },
      "insightLines": [
        {
          "key": "status",
          "label": "Stand",
          "variants": [
            {
              "text": "{total} Lieferscheine in der aktuellen Sicht; {draft} Entwürfe und {delivered} als zugestellt markiert."
            }
          ]
        },
        {
          "key": "shipping",
          "label": "Versand",
          "variants": [
            {
              "text": "Der Belegstatus belegt keinen Transportstatus."
            }
          ]
        }
      ],
      "roleFocus": {
        "defaultKey": "all",
        "options": [
          {
            "key": "all",
            "label": "Alle Rollen"
          },
          {
            "key": "shipping",
            "label": "Versand",
            "insightLineKeys": [
              "shipping",
              "status"
            ]
          },
          {
            "key": "sales",
            "label": "Vertrieb",
            "insightLineKeys": [
              "status"
            ]
          },
          {
            "key": "logistics",
            "label": "Logistik",
            "insightLineKeys": [
              "shipping"
            ]
          },
          {
            "key": "billing",
            "label": "Faktura",
            "insightLineKeys": [
              "status"
            ]
          },
          {
            "key": "management",
            "label": "Leitung",
            "insightLineKeys": [
              "status",
              "shipping"
            ]
          }
        ]
      }
    }
  }
}
