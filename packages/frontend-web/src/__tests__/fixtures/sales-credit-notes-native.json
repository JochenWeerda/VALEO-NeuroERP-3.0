  "agentContract": {
    "businessPurpose": "Gutschrift an den Kunden (Rechnungskorrektur) erfassen und buchen: Positionen mit Steuerschluessel, Erloes netto, Umsatzsteuer getrennt, Forderung brutto; ohne eindeutige Steuerangabe wird nicht gebucht, sondern der Pruefgrund genannt.",
    "examplePrompts": [
      "Lege eine Gutschrift ueber 1.000 EUR netto mit Steuerschluessel 3 zur Rechnung RE-1001 an.",
      "Warum wurde Gutschrift {entity_id} nicht gebucht?",
      "Welche Gutschriften sind noch Entwurf?"
    ],
    "dangerousActions": [
      {
        "key": "buchen",
        "reason": "Buchung ins Hauptbuch mit Umsatzsteuerberichtigung und OP-Minderung: Die Maskenaktion ist forbiddenForAgents. Ein Agent schlaegt die Buchung vor (sales.gutschrift.propose), ein Mensch prueft und gibt frei, erst dann bucht der Agent (sales.gutschrift.buchen)."
      },
      {
        "key": "vorschlag_freigeben",
        "reason": "Die Freigabe ist die Pruefung durch einen Menschen (Vier Augen) — nie durch einen Agenten."
      },
      {
        "key": "vorschlag_ablehnen",
        "reason": "Die Ablehnung ist die Entscheidung eines Menschen — nie die eines Agenten."
      }
    ],
    "sensitiveFields": [],
