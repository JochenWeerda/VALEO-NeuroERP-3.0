          "label": "Ansprechpartner"
        },
        {
          "key": "date",
          "label": "Termin"
        },
        {
          "key": "status",
          "label": "Status"
        },
        {
          "key": "assigned_to",
          "label": "Zustaendig"
        },
        {
          "key": "overdue",
          "label": "Ueberfaellig"
        }
      ]
    }
