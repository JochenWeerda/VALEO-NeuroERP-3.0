# ======================================================
# VALEO NeuroERP – Produktionskonfiguration (Template)
# ======================================================
# Kopieren nach .env.production und anpassen:
#   cp .env.production.example .env.production
#
# Szenarien:
#   Server (LAN/VPN):     VITE_API_BASE_URL=http://192.168.x.x:8000
#   Server (Cloud/HTTPS): VITE_API_BASE_URL=https://api.your-domain.com
#   Tunnel (ngrok):       VITE_API_BASE_URL=https://xxxx.ngrok.io
#   Tunnel (Cloudflare):  VITE_API_BASE_URL=https://xxxx.trycloudflare.com
# ======================================================

# Backend-URL (HTTPS in Produktion!)
VITE_API_BASE_URL=https://api.your-domain.com

# Tenant-ID
VITE_TENANT_ID=YOUR-TENANT-ID

# ======================================================
# OIDC Konfiguration
# ======================================================
# Keycloak
VITE_OIDC_DISCOVERY_URL=https://auth.your-domain.com/realms/valeo/.well-known/openid-configuration
VITE_OIDC_CLIENT_ID=valeo-erp-frontend
VITE_OIDC_REDIRECT_URI=https://erp.your-domain.com/callback

# Azure AD
# VITE_OIDC_DISCOVERY_URL=https://login.microsoftonline.com/{tenant-id}/v2.0/.well-known/openid-configuration
# VITE_OIDC_CLIENT_ID={application-id}

# ======================================================
# Feature Flags
# ======================================================
VITE_ENABLE_DMS_INTEGRATION=true
VITE_ENABLE_WORKFLOW=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_PROSPECTING_UI=false

# ======================================================
# Branding
# ======================================================
VITE_COMPANY_NAME=Ihr Unternehmensname
VITE_COMPANY_LOGO=/logo.png

# ======================================================
# Monitoring (optional)
# ======================================================
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ID=
