# ======================================================
# VALEO NeuroERP – LAN-Vorschau Konfiguration
# ======================================================
# Für: Tests vom Handy / anderen Geräten im lokalen Netzwerk
#
# Verwendung:
#   cp .env.lan-preview .env
#   npm run build && npm run preview
#   → Handy Browser: http://192.168.188.148:4173
#
# WICHTIG: LAN-IP statt localhost verwenden!
#   localhost vom Handy aus = das Handy selbst, nicht der Laptop
#
# Eigene LAN-IP ermitteln:
#   Windows: ipconfig → IPv4-Adresse
#   Linux/Mac: ip addr oder ifconfig
# ======================================================

# Modus A (Direct): Browser ruft Backend direkt über LAN-IP auf
VITE_API_BASE_URL=http://192.168.188.148:8000

# Entwicklung
VITE_API_DEV_TOKEN=dev-token
VITE_DEMO_MODE=false

# Feature Flags
VITE_ENABLE_DMS_INTEGRATION=true
VITE_ENABLE_WORKFLOW=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_PROSPECTING_UI=true
