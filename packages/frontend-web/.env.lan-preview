# ======================================================
# VALEO NeuroERP – LAN-Vorschau / Server mit LAN-Zugriff
# ======================================================
# Verwendung: npm run dev:lan  oder  npm run preview:lan
#
# Szenarien:
#   A) Notebook-Dev:    Frontend + Backend lokal, Zugriff per Handy/Tablet
#   B) LAN-Server:      Dedizierter Server im Netzwerk, alle Clients im LAN
#   C) Tunnel (ngrok):  npm run dev + ngrok http 3001 (HMR über ngrok WSS)
#
# WICHTIG: LAN-IP statt localhost — Browser auf anderem Gerät kann
#   localhost nicht auflösen (= das eigene Gerät)!
#
# LAN-IP ermitteln:
#   Windows: ipconfig | findstr "IPv4"    → z.B. 192.168.1.100
#   Linux:   ip addr | grep "inet "       → z.B. 192.168.1.100
#   Mac:     ifconfig | grep "inet "      → z.B. 192.168.1.100
#
# Dann diese Datei anpassen:
#   VITE_API_BASE_URL=http://<DEINE-LAN-IP>:8000
# ======================================================

# Modus A (Direct): Browser ruft Backend direkt über LAN-IP auf
# CORS wird im Backend automatisch erlaubt (DEBUG=True)
# Anpassen auf eigene LAN-IP:
VITE_API_BASE_URL=http://192.168.188.148:8000

# Für Tunnel (ngrok): HMR über ngrok WSS
# VITE_HMR_HOST=xxxx.ngrok.io

# Tenant
VITE_TENANT_ID=00000000-0000-0000-0000-000000000001

# Auth
VITE_API_DEV_TOKEN=dev-token
VITE_DEMO_MODE=false

# Feature Flags
VITE_ENABLE_DMS_INTEGRATION=true
VITE_ENABLE_WORKFLOW=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_PROSPECTING_UI=true
