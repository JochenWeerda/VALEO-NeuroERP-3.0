{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/app/**/*",
    "src/components/navigation/**/*",
    "src/components/patterns/**/*",
    "src/components/ui/**/*",
    "src/vite-env.d.ts",
    "src/shared/**/*",
    "src/features/agrar/**/*",
    "src/pages/agrar/**/*",
    "src/hooks/useFeature.ts",
    "src/hooks/useSSE.ts",
    "src/lib/mcp-event-bus.ts",
    "src/lib/sse-client.ts",
    "src/lib/useMcpRealtime.ts",
    "src/main.tsx",
    "src/types/**/*",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "vite.config.performance.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
