{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "outDir": "node_modules/.tmp/vite-config",
    "tsBuildInfoFile": "node_modules/.tmp/vite-config.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
