FROM node:20

***REMOVED*** Set working directory
WORKDIR /app

***REMOVED*** Copy package.json and install dependencies
COPY packages/frontend-web/package.json ./
RUN npm install

***REMOVED*** Copy source code
COPY packages/frontend-web/ ./

***REMOVED*** Copy vite config to root for proper config loading
RUN cp vite.config.js /app/vite.config.js 2>/dev/null || true

***REMOVED*** Add node_modules/.bin to PATH
ENV PATH="/app/node_modules/.bin:$PATH"

***REMOVED*** Expose port
EXPOSE 3000

***REMOVED*** Default command will be overridden in docker-compose.yml
CMD ["vite", "--host", "0.0.0.0", "--port", "3000"]