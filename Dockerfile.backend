ARG PYTHON_IMAGE=python:3.13.15-slim-bookworm
FROM ${PYTHON_IMAGE} AS builder

WORKDIR /build

# Build dependencies stay out of the runtime image.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# pip wird nur zum Installieren gebraucht und danach aus dem venv entfernt:
# es liefert msgpack und setuptools gebuendelt mit (pip/_vendor/vendor.txt).
# Diese Kopien schlagen im Container-Scan als GHSA-6v7p-g79w-8964 und
# CVE-2025-47273 auf. Auch das neueste pip vendort weiterhin msgpack 1.1.2
# und setuptools 70.3.0 — ein pip-Upgrade behebt es deshalb nicht
# (SECURITY-SCAN-20260910).
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt \
    && /opt/venv/bin/pip uninstall --yes pip

FROM ${PYTHON_IMAGE} AS runtime

# Das Laufzeit-Image installiert nichts nach: CMD ist init_db.py plus uvicorn,
# kein Codepfad ruft pip auf. Statt pip zu aktualisieren wird es entfernt,
# aus demselben Grund wie im Builder-Stage.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && python -m pip uninstall --yes pip \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1000 appuser \
    && useradd --system --uid 1000 --gid appuser --create-home appuser

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv

COPY --chown=appuser:appuser app/ ./app/
COPY --chown=appuser:appuser modules/ ./modules/
COPY --chown=appuser:appuser scripts/ ./scripts/
COPY --chown=appuser:appuser main.py ./
COPY --chown=appuser:appuser alembic/ ./alembic/
COPY --chown=appuser:appuser alembic.ini ./
COPY --chown=appuser:appuser config/ ./config/

RUN mkdir -p /app/config /app/data /app/logs /app/runtime \
    && chown -R appuser:appuser /app/config /app/data /app/logs /app/runtime

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER 1000:1000

CMD ["sh", "-lc", "python scripts/init_db.py && uvicorn main:app --host 0.0.0.0 --port 8000"]




