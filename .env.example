# Environment variables for local development
# Default PostgreSQL DSN for local development (used by app.core.config.Settings)
DATABASE_URL=postgresql://valeo_dev:REDACTED_PASSWORD@localhost:5432/valeo_neuro_erp
API_DEV_TOKEN=dev-token
API_URL=http://localhost:8000
OIDC_CLIENT_ID=
OIDC_ISSUER_URL=
OIDC_JWKS_URL=

# --- OpenTelemetry / Tracing (Gap 039, optional) ---
# OTLP HTTP (z. B. Jaeger all-in-one, Grafana Tempo, OTel Collector):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Service-Name in Spans (Default in app.core.config: valeo-neuroerp-api):
#   OTEL_SERVICE_NAME=valeo-neuroerp-api
# Ohne OTLP-Endpoint: ConsoleSpanExporter aktivieren (nur Dev):
#   ENABLE_TRACING=true
# Hinweis: Pip-Pakete stehen in requirements.txt; ohne Pakete nur Log-Warnung, kein Crash.

# --- Rationsoptimierung (Backend-Proxy → Microservice) ---
# RATIONS_OPTIMIZATION_URL=http://localhost:8010
# RATIONS_OPTIMIZATION_API_KEY=dev-api-key-change-in-production

# DLG-Merge: zusammengeführte Referenz-Futtermittel (nur Microservice rationsoptimierung).
# Referenzdatei im Container/Volume: data/reference/dlg_merged_feeds_lp.csv
# RATIONS_DLG_MERGED_ENABLE=1
# RATIONS_DLG_MERGED_TENANT_ID=dlg

# --- AI Developer Tools (Aider + Continue.dev) ---
# ANTHROPIC_API_KEY=sk-ant-...

