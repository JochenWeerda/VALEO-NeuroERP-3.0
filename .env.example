# Environment variables for local development
# Default PostgreSQL DSN for local development (used by app.core.config.Settings)
DATABASE_URL=postgresql://valeo_dev:REDACTED_PASSWORD@localhost:5432/valeo_neuro_erp
# Pruefstand fuer Schema- und Vertragstests: eine frisch migrierte Datenbank.
# Wird von scripts/pruefstand_db.py aufgesetzt (drop, create, migrate) und von
# den Tests ueber DATABASE_URL="$TEST_DATABASE_URL" vorgeschaltet. Fehlt die
# Variable, wird sie aus DATABASE_URL abgeleitet (Datenbankname -> valeo_probe).
# Regel: Schema frisch pruefen, Daten gewachsen. Runbook:
# docs/quality-assurance/pruefstand-datenbank.md
TEST_DATABASE_URL=postgresql://valeo_dev:REDACTED_PASSWORD@localhost:5432/valeo_probe

# Optional: eigene PostgreSQL-URL für ERP/SQL-Migrationen (Runner: ERP_DATABASE_URL → DATABASE_URL → CRM_DATABASE_URL)
# ERP_DATABASE_URL=postgresql://valeo_dev:REDACTED_PASSWORD@localhost:5432/valeo_neuro_erp
API_DEV_TOKEN=dev-token
# WEBFLEET.connect, Aktion showVehicleReportExtern. Leer lassen, solange kein Konto hinterlegt ist.
# WEBFLEET_ACCOUNT=
# WEBFLEET_USER=
# WEBFLEET_PASSWORD=
# WEBFLEET_APIKEY=
API_URL=http://localhost:8000
OIDC_CLIENT_ID=
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
EVENT_BUS_ENABLED=true
EVENT_BUS_PROVIDER=nats
EVENT_BUS_NATS_URL=nats://localhost:4222

# --- Integration bootstrap / external systems ---
# SECRET_PROVIDER=env
# HASHICORP_VAULT_ADDR=
# HASHICORP_VAULT_TOKEN=
# SUPERGLUE_ENABLED=false
# SUPERGLUE_BASE_URL=http://localhost:3011
# SUPERGLUE_AUTH_TOKEN=
# CRM_CORE_BASE_URL=http://localhost:5600
# CRM_SALES_BASE_URL=http://localhost:5700
# CRM_SERVICE_BASE_URL=http://localhost:5800

# --- OpenTelemetry / Tracing (Gap 039, optional) ---
# OTLP HTTP (z. B. Jaeger all-in-one, Grafana Tempo, OTel Collector):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Service-Name in Spans (Default in app.core.config: valeo-neuroerp-api):
#   OTEL_SERVICE_NAME=valeo-neuroerp-api
# Ohne OTLP-Endpoint: ConsoleSpanExporter aktivieren (nur Dev):
#   ENABLE_TRACING=true
# Hinweis: Pip-Pakete stehen in requirements.txt; ohne Pakete nur Log-Warnung, kein Crash.

# --- Obsidian Knowledge Vault (RAG-002) ---
# Pfad zum Obsidian-Vault-Verzeichnis fuer Knowledge-Sync:
#   OBSIDIAN_VAULT_PATH=/data/obsidian-vault
# Sync-Job: python scripts/obsidian_to_rag.py [--dry-run] [--tenant-id <id>]

# --- Rationsoptimierung (Backend-Proxy → Microservice) ---
# RATIONS_OPTIMIZATION_URL=http://localhost:8010
# RATIONS_OPTIMIZATION_API_KEY=dev-api-key-change-in-production

# Externe Herd-Data-/DDW-Connectoren (standardmaessig vollstaendig deaktiviert).
# Produktive Endpoint-Templates stammen ausschliesslich aus dem lizenzierten
# Providervertrag und werden tenantgebunden ueber die Integrations-API gepflegt.
# DDW_HERD_DATA_TOKEN=
# HERD_DATA_ALLOWED_DOMAINS=dairydatawarehouse.com

# DLG-Merge: zusammengeführte Referenz-Futtermittel (nur Microservice rationsoptimierung).
# Referenzdatei im Container/Volume: data/reference/dlg_merged_feeds_lp.csv
# RATIONS_DLG_MERGED_ENABLE=1
# RATIONS_DLG_MERGED_TENANT_ID=dlg

# --- AI Developer Tools (Aider + Continue.dev) ---
# ANTHROPIC_API_KEY=sk-ant-...
# POS fiscalization providers
# Secrets stay server-side. Never expose them as VITE_* variables.
FISKALY_API_KEY=your-fiskaly-api-key
FISKALY_API_SECRET=your-fiskaly-api-secret
FISKALY_SIGN_BASE_URL=https://kassensichv-middleware.fiskaly.com/api/v2
FISKALY_DSFINVK_BASE_URL=https://dsfinvk.fiskaly.com/api/v1

# Optional fiskaly products remain disabled until the licensed contract
# version from the fiskaly workspace is recorded. These values expose no
# secret and do not enable guessed live calls.
FISKALY_SUBMIT_DE_CONTRACT_VERSION=
FISKALY_RECEIPT_CONTRACT_VERSION=
FISKALY_SAFE_CONTRACT_VERSION=

# Swissbit Cloud TSE 2 REST API (partner documentation/credentials required)
SWISSBIT_CLOUD_BASE_URL=
SWISSBIT_CLOUD_API_TOKEN=

# Swissbit hardware TSE 1/1.1/2 through a local SDK gateway maintained by ops
SWISSBIT_GATEWAY_BASE_URL=http://127.0.0.1:8765
SWISSBIT_GATEWAY_API_TOKEN=

# Must match the contract version supplied in the Swissbit partner package.
# An empty value blocks Swissbit live operation.
SWISSBIT_API_CONTRACT_VERSION=

# ── E-Mail-Versand ─────────────────────────────────────────────────────────────
# Schluessel fuer gespeicherte Zugangsdaten (Postfach-Passwoerter, Google-Token,
# IMAP-Passwort): 32 Byte Base64, z. B. `openssl rand -base64 32`. Ohne ihn
# werden keine Zugangsdaten gespeichert. Nicht wechseln, solange Daten liegen.
VALEO_SECRET_KEY=
# Plattformkonto (nur, wenn ein Mandant keine eigenen Postfaecher fuehrt).
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
# Anmeldung bei Google bzw. Microsoft 365 fuer Postfaecher (OAuth-Clients der Plattform).
# Rueckruf fuer beide: https://<host>/admin/postfaecher/anmeldung-rueckruf
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Microsoft Entra ID: App-Registrierung, delegierte Berechtigung Mail.Send + offline_access.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=
# Verzeichnis-ID des Kunden oder "organizations" (jedes Geschaeftskonto).
MICROSOFT_OAUTH_TENANT=organizations
