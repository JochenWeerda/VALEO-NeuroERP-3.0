  "tax_logic_grain_accounts": {
    "jurisdiction": "DE",
    "compliance_reference": [
      "UStG §13 (steuerentstehung)",
      "UStG §15 (vorsteuerabzug)",
      "UStG §24 (durchschnittssaetze landwirtschaft)"
    ],
    "process_model": {
      "business_case": "einlagerungskunde liefert getreide ein; landhandel kauft erst spaeter",
      "rules": [
        {
          "key": "no_purchase_no_input_vat",
          "rule": "Keine vorsteuer aus einkauf ziehen, solange kein steuerbarer einkaufsvorgang mit rechnung/zahlung vorliegt."
        },
        {
          "key": "tax_point_on_purchase_or_advance",
          "rule": "USt entsteht mit ausfuehrung der lieferung bzw. bei anzahlung bereits bei vereinnahmung."
        },
        {
          "key": "farmer_compensation_at_actual_purchase_date",
          "rule": "Weiterverguetung an landwirt erst mit tatsaechlichem kaufdatum/abrechnung und zugehoerigem steuertatbestand."
        }
      ],
      "erp_fields": [
        { "key": "storage_booking_type", "type": "enum", "values": ["storage_only", "purchase"] },
        { "key": "ownership_status", "type": "enum", "values": ["farmer_owned", "dealer_owned"] },
        { "key": "purchase_contract_id", "type": "uuid" },
        { "key": "purchase_date_actual", "type": "date" },
        { "key": "input_vat_claimable", "type": "boolean" },
        { "key": "input_vat_claim_date", "type": "date" },
        { "key": "farmer_compensation_due_date", "type": "date" },
        { "key": "farmer_compensation_paid_at", "type": "datetime" },
        { "key": "tax_regime", "type": "enum", "values": ["regular_vat", "avg_rate_24_ustg"] },
        { "key": "tax_decision_log", "type": "json_array_object" }
      ],
      "note": "fachliche/steuerliche pruefung durch steuerberater erforderlich"
    }
  },
