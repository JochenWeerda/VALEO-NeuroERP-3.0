{
  "meta": {
    "mode": "option_2",
    "description": "Full structured extraction for OCR tab-based master data. UI tabs are separated from persistent data fields.",
    "version": "2026-02-14",
    "language": "de"
  },
  "extraction_protocol": {
    "batch_size_images": 10,
    "input_expected": "screenshots with all tab headers clicked by user",
    "output_strategy": [
      "group fields by tab title",
      "separate ui_navigation labels from data fields",
      "mark uncertain OCR fields with confidence low",
      "map each field to normalized target entity"
    ],
    "normalization_rules": {
      "repeatable_rows": "own child table",
      "time_validity": "valid_from/valid_to on child item",
      "money": "decimal with explicit scale",
      "percent": "decimal percent 0..100",
      "contact_persons": "separate contact table"
    }
  },
