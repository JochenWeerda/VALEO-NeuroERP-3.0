# Lokale Entwicklung / Docker: Rationsoptimierung-Microservice
# Referenzdatei für DLG-Merge (im Repo-Pfad relativ zum Service):
#   data/reference/dlg_merged_feeds_lp.csv

ENVIRONMENT=development
LOG_LEVEL=info

# API-Key (muss mit Backend RATIONS_OPTIMIZATION_API_KEY übereinstimmen)
# RATIONS_OPTIMIZATION_API_KEY=dev-api-key-change-in-production

# DLG-Merge: zusammengeführte Referenz-Futtermittel für konfigurierten Tenant
# RATIONS_DLG_MERGED_ENABLE=1
# RATIONS_DLG_MERGED_TENANT_ID=dlg
