{
  "name": "@valero-neuroerp/mono",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@9.12.0+sha512.4abf725084d7bcbafbd728bfc7bee61f2f791f977fd87542b3579dcb23504d170d46337945e4c66485cd12d588a0c0e570ed9c477e7ccdd8507cf05f3f92eaca",
  "pnpm": {
    "overrides": {
      "multer": "^2.2.0",
      "ws": "^8.21.0",
      "form-data": "^4.0.6",
      "rollup": "npm:@rollup/wasm-node@^4.29.0",
      "baseline-browser-mapping": "2.10.0",
      "browserslist": "4.28.1",
      "caniuse-lite": "1.0.30001777",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "@opentelemetry/auto-instrumentations-node": "^0.76.0",
      "@opentelemetry/exporter-prometheus": "^0.218.0",
      "@opentelemetry/sdk-node": "^0.218.0",
      "@xmldom/xmldom": "^0.8.13",
      "axios": "^1.17.0",
      "defu": "^6.1.5",
      "drizzle-orm": "^0.45.2",
      "effect": "^3.20.0",
      "fast-uri": "^3.1.2",
      "fast-xml-parser": "^5.8.0",
      "fastify": "^5.7.2",
      "glob": "^10.5.0",
      "handlebars": "^4.7.9",
      "jws": "^3.2.3",
      "lodash": "^4.18.1",
      "minimatch": "^9.0.7",
      "node-forge": "^1.4.0",
      "nodemailer": "^9.0.1",
      "path-to-regexp": "^0.1.13",
      "picomatch": "^4.0.4",
      "protobufjs": "^7.5.6",
      "semver": "^7.7.4",
      "shell-quote": "^1.8.4",
      "socket.io-parser": "^4.2.6",
      "tar": "^7.5.11",
      "tmp": "^0.2.6",
      "validator": "^13.15.22",
      "yaml": "^2.8.2"
    }
  },
  "scripts": {
    "prepare": "husky",
    "clean": "rimraf ./packages/*/dist",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "docs:lint": "node scripts/docs-markdown-check.cjs",
    "docs:governance": "node scripts/docs-governance-check.cjs",
    "docs:sync": "node scripts/docs-code-sync-check.cjs",
    "docs:drift": "node scripts/docs-drift-report.cjs",
    "ai:slice:check": "node scripts/ai-slice-readiness-check.cjs --changed-only",
    "docs:check": "pnpm run docs:lint && pnpm run docs:governance",
    "todo:scan": "python scripts/update_todos.py --repo-only",
    "todo:scan:full": "python scripts/update_todos.py",
    "test": "pnpm -r run test",
    "check:dupes": "node scripts/check-dupes.cjs",
    "guard:paths:staged": "node scripts/guard-forbidden-paths.cjs --staged",
    "guard:paths:range": "node scripts/guard-forbidden-paths.cjs --range",
    "ts:check": "tsc -b tsconfig.build.json",
    "dev": "pnpm -r run dev",
    "mcp:dev": "ts-node src/mcp-server.ts",
    "policy:seed": "ts-node scripts/seed-policies.ts",
    "policy:init": "pnpm run policy:seed && echo Policy-Datenbank bereit!",
    "migrate:erp-finanz": "npx ts-node tools/migration/run_sql_migration.ts --file migrations/sql/erp/001_finance_core.sql --file migrations/sql/erp/003_finanz_tenant_id.sql",
    "test:erp-domain": "pnpm --filter @valero-neuroerp/erp-domain test",
    "lint-staged": "lint-staged",
    "test:e2e:smoke": "playwright test --grep @smoke --project=smoke",
    "test:e2e:full": "playwright test --grep @full --project=full",
    "test:e2e:fallback": "playwright test --grep @fallback --project=fallback-verification",
    "test:e2e:critical": "playwright test --config playwright.config.critical.ts",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.48.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.1",
    "@types/pg": "^8.15.6",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "commander": "^14.0.2",
    "csv-parse": "^6.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-perfectionist": "^2.11.0",
    "eslint-plugin-sonarjs": "^1.0.3",
    "eslint-plugin-unicorn": "^54.0.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "express": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "pg": "^8.16.3",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "uuid": "^13.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "eslint"
    ],
    "*.md": [
      "node scripts/docs-markdown-check.cjs",
      "node scripts/docs-governance-check.cjs"
    ],
    "*.json": []
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  }
}
